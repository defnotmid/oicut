package main

import "core:fmt"
import "core:strings"
import "core:unicode"
import "core:unicode/utf8"

// video/av1/tables.odin from the AV1 Bitstream & Decoding Process
// Specification v1.0.0 with Errata 1 (2019-01-08), the primary document:
//
//	https://aomediacodec.github.io/av1-spec/av1-spec.pdf
//	sha256 ec44e9fc42c4e5851faa879a1818dcb9014d834bbdd9420ccca7dcea05a3abe9
//	pdftotext -layout av1-spec.pdf av1-spec.txt
//
// Every `Name[ dims ] = { ... }` table in the text is transcribed:
// dimensions and symbolic entries resolve through the constants of section 3
// and the value tables of section 6, element counts are checked against the
// dimensions, and each table gets the narrowest integer type holding its
// values.
av1_tables :: proc(out: ^strings.Builder, spec: string) {
	lines := make([dynamic]string)
	text := read(spec)
	for line in split_lines(&text) {
		// Page furniture interrupts tables that span pages.
		if strings.has_prefix(line, "Section: ") && strings.contains(line, "Page ") do continue
		if strings.contains(line, "AV1 Bitstream & Decoding Process Specification") do continue
		append(&lines, line)
	}
	constants := av1_constants(lines[:])
	joined := strings.join(lines[:], "\n")

	strings.write_string(out, "// Generated by tools/tables from the AV1 Bitstream & Decoding Process\n")
	strings.write_string(out, "// Specification v1.0.0 with Errata 1. Do not edit.\npackage av1\n\n")
	count := 0
	for i := 0; i < len(joined); i += 1 {
		name, dims, body_start, found := av1_table_head(joined, i, constants)
		if !found do continue
		body, _ := braced(joined, body_start)
		// Split_Tx_Size in section 9 of the specification omits the comma after entry 12 (TX_32X32).
		cleaned := strip_comments(body)
		if name == "Split_Tx_Size" do cleaned, _ = strings.replace_all(cleaned, "TX_32X32\n", "TX_32X32,\n")
		values := table_values(cleaned, dims, constants)
		total := 1
		for d in dims do total *= d
		if len(values) != total do fail("%s: %d values for dims %v", name, len(values), dims)
		// Scans share one element type so every transform size reads the same slice type;
		// CDF tables share u16 so every symbol reader/writer takes []u16.
		lower := strings.to_lower(name)
		kind := strings.contains(lower, "scan") || strings.has_suffix(lower, "_cdf") ? "u16" : narrowest(values)
		nested_table(out, "rodata", strings.to_upper(name), kind, values, dims)
		count += 1
		i = body_start - 1
	}
	fmt.eprintfln("// %d tables", count)
}

av1_constants :: proc(lines: []string) -> map[string]i64 {
	constants := make(map[string]i64)
	define_expr :: proc(constants: ^map[string]i64, name, expr: string) {
		if name not_in constants do constants[name] = spec_value(expr, constants^)
	}
	section3, section4, semantics := -1, -1, -1
	for l, n in lines {
		if strings.has_prefix(l, "3. Symbols and abbreviated terms") do section3 = n
		if strings.has_prefix(l, "4. Conventions") do section4 = n
		if strings.has_prefix(l, "6. Syntax structures semantics") do semantics = n
	}
	expect(section3 >= 0 && section4 > section3 && semantics > section4, "sections 3, 4, 6")
	for n := section3; n < section4; n += 1 {
		l := lines[n]
		s := skip_space(l, 0)
		e := upper_name(l, s)
		if e == s || e >= len(l) || !is_space(l[e]) do continue
		v := skip_space(l, e)
		// Value column ends before the description column (separated by >= 2 spaces).
		ve := v
		for ve < len(l) {
			if is_space(l[ve]) && ve + 1 < len(l) && is_space(l[ve + 1]) do break
			ve += 1
		}
		if ve == v do continue
		expr := strings.trim_space(l[v:ve])
		// SUPERRES_FILTER_SHIFTS wraps its shift operand onto the next line.
		if strings.has_suffix(expr, "<<") && n + 1 < section4 {
			expr = fmt.tprintf("%s %s", expr, strings.trim_space(lines[n + 1]))
		}
		define_expr(&constants, l[s:e], expr)
	}
	for l in lines[semantics:] {
		// Section 7 2-column constant tables: NAME value.
		if s0 := skip_space(l, 0); s0 < len(l) {
			if e0 := upper_name(l, s0); e0 > s0 && e0 < len(l) && is_space(l[e0]) {
				v0 := skip_space(l, e0)
				d0 := digits_end(l, v0)
				if d0 > v0 && skip_space(l, d0) == len(l) {
					define_expr(&constants, l[s0:e0], l[v0:d0])
					continue
				}
			}
		}
		// Section 6: value NAME [notes], or value1 value2 NAME (FrameRestorationType).
		v := skip_space(l, 0)
		d := digits_end(l, v)
		if d == v || d >= len(l) || !is_space(l[d]) do continue
		s := skip_space(l, d)
		if e := upper_name(l, s); e > s && (e == len(l) || is_space(l[e])) {
			define_expr(&constants, l[s:e], l[v:d])
			continue
		}
		v2 := s
		d2 := digits_end(l, v2)
		if d2 == v2 || d2 >= len(l) || !is_space(l[d2]) do continue
		s2 := skip_space(l, d2)
		if e := upper_name(l, s2); e > s2 && (e == len(l) || is_space(l[e])) {
			define_expr(&constants, l[s2:e], l[v2:d2])
		}
	}
	return constants
}

av1_table_head :: proc(s: string, i: int, constants: map[string]i64) -> (name: string, dims: []int, body: int, found: bool) {
	if !((s[i] >= 'A' && s[i] <= 'Z') || (s[i] >= 'a' && s[i] <= 'z')) do return
	if i > 0 {
		r, _ := utf8.decode_last_rune_in_string(s[:i])
		if r == '_' || unicode.is_letter(r) || unicode.is_digit(r) do return
	}
	j := i
	for j < len(s) && is_word(s[j]) do j += 1
	name = s[i:j]
	// Constant table names in the AV1 spec are Title_Case with underscores.
	if !strings.contains_rune(name, '_') || s[i] < 'A' || s[i] > 'Z' do return
	j = skip_space(s, j)
	dim_text := make([dynamic]string)
	for j < len(s) && s[j] == '[' {
		start := skip_space(s, j + 1)
		e := start
		for e < len(s) && (is_space(s[e]) || is_word(s[e]) || strings.index_byte("+-*<>()", s[e]) >= 0) do e += 1
		if e == start || e >= len(s) || s[e] != ']' do return
		// Dimension expressions must start with a digit, '(', or an ALL_CAPS constant name (not loop variables like `i`).
		trimmed := strings.trim_space(s[start:e])
		if trimmed == "" || !(is_digit(trimmed[0]) || trimmed[0] == '(' || (trimmed[0] >= 'A' && trimmed[0] <= 'Z' && upper_name(trimmed, 0) > 0)) do return
		append(&dim_text, trimmed)
		j = skip_space(s, e + 1)
	}
	if len(dim_text) == 0 || j >= len(s) || s[j] != '=' do return
	j = skip_space(s, j + 1)
	if j >= len(s) || s[j] != '{' do return
	dims = make([]int, len(dim_text))
	for d, k in dim_text do dims[k] = int(spec_value(d, constants))
	return name, dims, j + 1, true
}
