// However little is cut off, the file is refused; bytes after the RIFF size
// are not part of it.
@(test)
a_cut_off_file_is_refused :: proc(t: ^testing.T) {
	img, err := decode(lossy[:])
	testing.expect_value(t, err, Error.None)
	testing.expect_value(t, img.width, 32)
	defer destroy_image(&img)
	for n in 0 ..< len(lossy) {
		_, err = decode(lossy[:n])
		testing.expect_value(t, err, Error.Invalid)
	}
	longer := make([]u8, len(lossy) + 7)
	defer delete(longer)
	copy(longer, lossy[:])
	again: Image
	again, err = decode(longer)
	testing.expect_value(t, err, Error.None)
	defer destroy_image(&again)
	testing.expect(t, string(again.pixels) == string(img.pixels))
}
